# Generated by the release workflow in connickshields/sightglass from
# packaging/sightglass.rb.tmpl. Edits made here are overwritten by the next
# release, so change the template instead.
cask "sightglass" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/connickshields/sightglass/releases/download/v#{version}/Sightglass-#{version}.zip"
  name "Sightglass"
  desc "Menu bar gauges for JSON status files from long-running jobs"
  homepage "https://github.com/connickshields/sightglass"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sequoia

  app "Sightglass.app"

  # Sightglass is ad-hoc signed, not notarized. Gatekeeper won't open a
  # quarantined app without a Developer ID signature, and it fails silently:
  # the app just never opens. Removing the attribute lets it launch.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Sightglass.app"]
  end

  uninstall quit: "io.github.connickshields.sightglass"

  zap trash: "~/Library/Application Support/Sightglass"
end
